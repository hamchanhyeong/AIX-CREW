# 이 파일을 .env.local로 복사해 값을 채우세요. .env.local은 Git에 포함되지 않습니다.
# 키가 없어도 데모 모드(샘플 작업공간)와 템플릿 작성·편집·변경 비교·내보내기는 모두 동작합니다.

# LLM 제공자 (현재 구현: anthropic)
LLM_PROVIDER=anthropic

# 사용할 모델 ID (기본값: claude-opus-5-5)
LLM_MODEL=claude-opus-5-5

# Anthropic API 키 — 서버에서만 읽으며 브라우저·로그·저장소에 노출하지 않습니다.
ANTHROPIC_API_KEY=

# 거절(refusal) 시 서버 측 대체 모델 사용 여부 (기본 on, 끄려면 off)
LLM_REFUSAL_FALLBACK=on

# 작업 데이터 저장 폴더 (기본: ./data)
# DATA_DIR=./data
